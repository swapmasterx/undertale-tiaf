[resource]
script = ExtResource("1_dxftn")
dialog_set = Array[Array]([["`* GOTCHA!!!"], ["~* What a terrible creature,|||||| torturing another innocent monster...", "* Earlier that thing was trying to dig through the flower patch at the end of the ruins...", "* Apologies I'm rambling.||||||||| I do not belive I have seen you around here before.", "* My name is Toriel,|||||| and I am the caretaker of the Ruins. ", "* .|||.|||.", "* You want to say something but the words die on your mouth.", "* Is |everything alright? |||||||| You are not hurt are you?", "* ...||||||uh...|||||||||||no.|||||| I'm ||||||||||||fine.", "* If you are certain then I will be on my way for now.", "* My home is at the end of the ruins in the case you need anything else.", "* Take care."], ["`* (Why was I so...|||||||| frozen?)", "* (It was just mom! ||||||||||If there was anyone who could help me it would be her.)", "* But that's not what caused you to lock up.", "* (No it's not. It's the fact that she looks so much older then when we last saw her.)", "* Wait you can HEAR ME?!", "* (Yeah?)", "* Why didn't you say anything?!", "* (You were just doing that narration thing you always do.) ", "* (I didn't want to call you out on it {name}.)", "* ...|||||||||||You know what thats fair.", "* So what is the plan then Asriel?", "* (We catch up to mom.||||||| Find out what happenend after we died and how long we were dead for.)", "* (As well as get the record straight...)", "*What do you mean?", "* (Ever since I woke up, my memories feel like a haze. |||||||||||Like I'm only half there.)", "* Come to think of it I'm in the same boat.", "* Its not entirely amnisia, but it feels like a lot of my memories are behind really foggy glass.", "* (So not only have we been gone for what seems like a while. But our memories are also shot.)", "* Could be worse, we could still be dead.", "* (I'm not sure how much being a talking flower can be considered living.)", "* (Either way,||||||||| lets get moving.|||||||| Need to catch up to mom.)"]])
speech_noise_id = Array[Array]([["flowey_evil"], ["toriel", "toriel", "toriel", "toriel", "flowey", "default1", "toriel", "flowey", "toriel", "toriel", "toriel"], ["flowey", "flowey", "default1", "flowey", "default1", "flowey", "default1", "flowey", "flowey", "default1", "default1", "flowey", "flowey", "default1", "flowey", "default1", "default1", "flowey", "default1", "flowey", "flowey"]])
